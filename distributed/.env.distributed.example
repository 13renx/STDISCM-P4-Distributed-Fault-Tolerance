# -----------------------------------------------------------------------------
# Environment variables for the distributed fault-tolerance subsystem.
# Copy relevant lines into your .env (or export them) on each node.
# On separate machines/VMs, replace the localhost URLs with real addresses.
# -----------------------------------------------------------------------------

# --- Database node -----------------------------------------------------------
# Single host, OR a replica-set string for the redundancy bonus, e.g.
#   mongodb://m1:27017,m2:27017,m3:27017/enrollment?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017/enrollment
DB_SELECTION_TIMEOUT_MS=1500   # fail fast when the DB node is unreachable
DB_PING_INTERVAL_MS=2000       # how often the DB service pings for liveness
DB_HEALTH_PORT=6000            # port the DB health sidecar listens on

# --- Node health URLs (used by the failure detector / monitor) ---------------
VIEW_URL=http://localhost:4000
APP_URL=http://localhost:5000
DB_HEALTH_URL=http://localhost:6000

# --- Failure-detector timing -------------------------------------------------
HEARTBEAT_INTERVAL_MS=2000     # how often each node is probed
SUSPECT_AFTER_MISSES=2         # missed intervals before SUSPECT
DOWN_AFTER_MISSES=4            # missed intervals before DOWN
PROBE_TIMEOUT_MS=1500          # per-probe timeout

# --- Roles / ports -----------------------------------------------------------
NODE_ROLE=app                  # view | app | db | monitor
MONITOR_PORT=7000              # cluster monitor dashboard port
PORT=5000                      # app node port (used by index.js)
